# Copy this file OUTSIDE the Git worktree, fill in the site-specific values,
# and pass that copy to every cluster script. Registered runs require a clean
# worktree, so an untracked configuration inside the repository is forbidden.

ARCMIND_REPO_ROOT=/shared/projects/arcmind/repo
ARCMIND_VENV=/shared/projects/arcmind/venvs/pobax-py312
ARCMIND_CLUSTER_ROOT=/shared/scratch/arcmind-study
ARCMIND_EXPECTED_COMMIT=0000000000000000000000000000000000000000

# Used only by setup_env.sh. The resulting venv is reused unchanged for every
# stage so that the recorded Python patch version and package contract match.
ARCMIND_PYTHON_BOOTSTRAP=python3.12

# JAX's exact device_kind is compared across all workers. This expression is
# an additional guard that the allocation is the promised 40 GB A100 class.
# Adjust only for the exact spelling reported by your homogeneous partition.
ARCMIND_DEVICE_KIND_REGEX='A100.*40GB'

# Site-specific Slurm routing. Empty values are omitted from sbatch.
ARCMIND_SLURM_ACCOUNT=
ARCMIND_SLURM_PARTITION=gpu
ARCMIND_SLURM_QOS=
ARCMIND_SLURM_CONSTRAINT=
ARCMIND_SLURM_GRES=gpu:a100:1
ARCMIND_SLURM_CPUS=8
ARCMIND_SLURM_MEMORY=64G

# A timed-out shard resumes at its last validated cell when resubmitted.
ARCMIND_SLURM_TIME_PREFLIGHT=00:30:00
ARCMIND_SLURM_TIME_TUNING=2-00:00:00
ARCMIND_SLURM_TIME_PRIMARY=2-00:00:00
ARCMIND_SLURM_TIME_UPPER=1-00:00:00
ARCMIND_SLURM_TIME_FINALIZE=04:00:00
